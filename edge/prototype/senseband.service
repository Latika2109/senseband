[Unit]
Description=SenseBand main band
After=network.target bluetooth.target

[Service]
# Change YOUR_USER to the username you set in Raspberry Pi Imager
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/senseband/main_band
ExecStart=/usr/bin/python3 /home/YOUR_USER/senseband/main_band/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
