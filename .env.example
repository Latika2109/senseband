# Copy to .env (local) or /etc/senseband/senseband.env (on the Pi, chmod 600). NEVER commit the real file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_32_char_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX          # a Twilio number you own (or use TWILIO_MESSAGING_SERVICE_SID=MG...)
ALERT_TO_NUMBERS=["+91XXXXXXXXXX"]       # who gets the critical-alert SMS (E.164, JSON list or comma separated)
SENSEBAND_BAND_TOKEN=generate_with_python_-c_"import secrets;print(secrets.token_hex(24))"
